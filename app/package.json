{
  "name": "tvthing-windows",
  "version": "1.0.0",
  "private": true,
  "description": "TV Thing for Windows: live TV on the Car Thing, with the sound on your Windows PC.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "dev": "node scripts/build.mjs && node scripts/dev-server.mjs",
    "dev:extension": "deno run -A dist/extension-dev.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc --noEmit && deno check --unstable-sloppy-imports extension/main.ts",
    "package": "npm run typecheck && npm test && node scripts/build.mjs --package",
    "test": "deno test --unstable-sloppy-imports -A tests/"
  },
  "dependencies": {
    "@bridgething/client": "^0.12.1",
    "hls.js": "^1.7.3"
  },
  "devDependencies": {
    "@bridgething/extension": "^0.12.1",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
