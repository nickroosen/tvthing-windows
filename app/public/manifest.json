{
  "id": "4b1ca844-3c6a-4e82-a9ca-b9b598c2c79f",
  "name": "TV Thing for Windows",
  "version": "1.0.0",
  "description": "A tiny TV for your Car Thing. Picture on the Car Thing, sound on your Windows PC. Add channels in settings.",
  "icon": "icon.svg",
  "permissions": [
    "net.fetch",
    "audio"
  ],
  "overlays": {
    "volume": false
  },
  "settings": "settings.html",
  "extension": {
    "entry": "extension/desktop.mjs",
    "permissions": [
      "net",
      "read",
      "write",
      "env",
      "run:ffmpeg",
      "run:~/AppData/Local/Microsoft/WinGet/Links/ffmpeg.exe",
      "run:~/scoop/shims/ffmpeg.exe",
      "run:C:/ProgramData/chocolatey/bin/ffmpeg.exe",
      "run:C:/ffmpeg/bin/ffmpeg.exe"
    ],
    "api": 1
  }
}
